# Copy this file to `.env` and fill in your own values:
#
#     copy .env.example .env          (Windows)
#     cp   .env.example .env          (Mac/Linux)
#
# `.env` is gitignored, so your settings stay on your machine. Every
# line below is optional - anything you leave out or comment out falls
# back to the default in config.py (Kharadi / Haveli / Pune).


# ---------------------------------------------------------------
# 1. OpenAI key - required, this is what reads the CAPTCHAs
# ---------------------------------------------------------------

OPENAI_API_KEY=sk-...

# "auto" solves CAPTCHAs with the vision model, "manual" makes you type
# each one. Auto falls back to manual on its own if the key is missing.
CAPTCHA_MODE=auto


# ---------------------------------------------------------------
# 2. Which village to scrape
# ---------------------------------------------------------------
#
# Run `python setup_location.py` - it walks the portal's own dropdowns
# and prints these six lines filled in for you. The names must match the
# dropdown text exactly (Marathi included), and the ids must belong to
# the same place, so copy all six together rather than editing one.

# IGR_DISTRICT=पुणे
# IGR_TALUKA=हवेली
# IGR_VILLAGE=खराडी (पुणे महापालिकेमध्ये समाविष्ट)

# IGR_DISTRICT_ID=23
# IGR_TALUKA_ID=1
# IGR_VILLAGE_ID=43


# ---------------------------------------------------------------
# 3. What to search for
# ---------------------------------------------------------------

# Survey numbers are walked one at a time, start through end inclusive.
# IGR_SURVEY_START=1
# IGR_SURVEY_END=99

# Registration years, newest first - the scraper works down this list.
# The portal has no data for 2003-2011.
# IGR_YEARS=2026,2025,2024,2023,2022,2021,2020,2019

# Stop once this many unique rows have been collected.
# IGR_TARGET_UNIQUE_ROWS=100000

# Output files are named <prefix>_<year>.csv - change this with the
# location, or your rows land in files named after someone else's village.
# IGR_CSV_PREFIX=kharadi_haveli_pune


# ---------------------------------------------------------------
# 4. Wi-Fi rotation (Windows only)
# ---------------------------------------------------------------
#
# The portal caps searches per IP per day. When it refuses, the scraper
# hops to the parking network and back to the hotspot to make the
# carrier hand out a fresh IP.
#
# These are the names Windows has saved, and they differ on every PC.
# Run `python setup_location.py --wifi` to list yours.
#
# HOTSPOT  = your phone's hotspot (the one that gets a new IP)
# PARKING  = any other saved network - broadband, a neighbour's, anything.
#            It only exists to force a real disconnect in between.

# IGR_WIFI_INTERFACE=Wi-Fi
# IGR_HOTSPOT_PROFILE=My Phone Hotspot
# IGR_PARKING_PROFILE=Home WiFi
